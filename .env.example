# PostgreSQL connection string (Vercel Postgres, Neon, Supabase, etc.)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Password for the /admin panel (choose a strong, unique value)
ADMIN_PASSWORD="change-me"

# Secret key for the private /api/payment endpoint — only you should know this
API_KEY="change-me-too"
